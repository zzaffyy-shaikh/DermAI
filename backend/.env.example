# Copy to .env and adjust. All vars are prefixed with DERMAI_.

# --- model ---
DERMAI_MODEL_PATH=C:\Users\ossam\Documents\fyp\codes\convnext_skin_fyp_new.pth
DERMAI_DEVICE=auto                 # auto | cuda | cpu

# --- decision gate (RE-CALIBRATE on a leakage-free val set!) ---
DERMAI_CONFIDENCE_THRESHOLD=0.60
DERMAI_ENTROPY_THRESHOLD=1.60      # max possible for 8 classes = ln(8) ≈ 2.08

# --- LLM ---
DERMAI_LLM_PROVIDER=scripted       # scripted | openai | gemini
# DERMAI_OPENAI_API_KEY=sk-...
DERMAI_OPENAI_MODEL=gpt-4o-mini
# Gemini (get a free key at https://aistudio.google.com/apikey):
DERMAI_GEMINI_API_KEY=......
DERMAI_GEMINI_MODEL=gemini-2.5-flash
DERMAI_MAX_QUESTIONS=4

# --- segmentation (optional) ---
# DERMAI_SAM_CHECKPOINT=C:\path\to\mobile_sam.pt

# --- auth ---
DERMAI_AUTH_MODE=dev               # dev | firebase
# DERMAI_FIREBASE_CREDENTIALS=C:\path\to\serviceAccount.json

# Copy this to ".env" in the repo root ON THE SERVER and fill in real values.
# (This file is read by docker-compose; it is git-ignored so secrets never commit.)

# Your public domain (no https://). Must resolve to the server's public IP.
DERMAI_DOMAIN=your-subdomain.duckdns.org

# Google Gemini key (free tier is fine). Rotate the old one — get a key at
# https://aistudio.google.com/apikey
DERMAI_GEMINI_API_KEY=replace-me

# Seeded administrator account (created on first boot). Use a STRONG password.
DERMAI_SEED_ADMIN_USERNAME=admin
DERMAI_SEED_ADMIN_PASSWORD=change-this-to-something-strong

# Optional — only if you use "Sign in with Google":
DERMAI_GOOGLE_CLIENT_ID=
DERMAI_GOOGLE_ANDROID_CLIENT_ID=
